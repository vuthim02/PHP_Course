{
    "name": "php-mastery/bookstore-api",
    "description": "RESTful Book Store API - Level 4 Professional Backend",
    "type": "project",
    "require": {
        "php": ">=8.1",
        "vlucas/phpdotenv": "^5.5",
        "firebase/php-jwt": "^6.10",
        "swagger-php/swagger-php": "^4.8",
        "phpunit/phpunit": "^10.5",
        "guzzlehttp/psr7": "^2.6"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "serve": "php -S localhost:8080 -t public",
        "test": "phpunit tests",
        "docs": "php vendor/bin/openapi src -o public/docs/openapi.json"
    }
}
